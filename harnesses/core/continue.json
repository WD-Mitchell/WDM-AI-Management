{
  "name": "continue",
  "label": "Continue",
  "builtin": true,
  "default_enabled": false,
  "auto_enable": true,
  "detect": {
    "paths": ["~/.continue", ".continue", ".continuerc.json"]
  },
  "renderers": {
    "agents": "markdown",
    "mcp": "json"
  },
  "schemas": {
    "agents": ["name", "description", "model", "version", "schema", "rules", "prompts", "docs", "context"],
    "skills": ["name", "description"],
    "rules": ["name", "description"],
    "workflows": ["name", "description"],
    "mcp": ["name", "description", "type", "command", "args", "env", "url"]
  },
  "field_mappings": {
    "agents": {
      "knowledge_docs": "docs",
      "context_items": "context"
    }
  },
  "models": {
    "agents": ["default", "anthropic/claude-sonnet-4.6", "openai/gpt-5.5", "google/gemini-3.1-pro"]
  },
  "outputs": {
    "agents": {"extension": ".md"},
    "skills": {"directory": true},
    "rules": {"extension": ".md"},
    "workflows": {"extension": ".md"},
    "mcp": {"extension": ".json"}
  },
  "sync": {
    "paths": {
      "project": {
        "agents": ".continue/agents/{name}.md",
        "skills": ".continue/skills/{name}/",
        "rules": ".continue/rules/{name}.md",
        "workflows": ".continue/prompts/{name}.md",
        "mcp": ".continue/mcpServers/{name}.json"
      },
      "global": {
        "agents": ".continue/agents/{name}.md",
        "skills": ".continue/skills/{name}/",
        "rules": ".continue/rules/{name}.md",
        "workflows": ".continue/prompts/{name}.md",
        "mcp": ".continue/mcpServers/{name}.json"
      }
    },
    "skip": {
      "config_yaml": "Continue's canonical config is config.yaml; this harness emits per-file managed pieces until a YAML config merger is added."
    }
  }
}

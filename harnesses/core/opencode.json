{
  "name": "opencode",
  "label": "OpenCode",
  "builtin": true,
  "default_enabled": false,
  "auto_enable": true,
  "detect": {
    "commands": ["opencode"],
    "paths": ["~/.config/opencode"]
  },
  "renderers": {
    "agents": "markdown",
    "mcp": "json"
  },
  "schemas": {
    "agents": ["description", "mode", "model", "temperature", "topP", "steps", "disable", "prompt", "permission", "tools", "hidden", "color"],
    "skills": ["name", "description", "paths", "disable-model-invocation", "metadata"],
    "rules": ["name", "description"],
    "workflows": ["name", "description", "mode", "model", "permission"]
  },
  "field_mappings": {
    "agents": {
      "top_p": "topP",
      "body": "prompt"
    },
    "skills": {
      "disable_model_invocation": "disable-model-invocation"
    }
  },
  "models": {
    "agents": ["default", "anthropic/claude-sonnet-4-5", "opencode/gpt-5.1-codex", "openai/gpt-5.5"]
  },
  "outputs": {
    "agents": {"extension": ".md"},
    "skills": {"directory": true},
    "rules": {"extension": ".md"},
    "workflows": {"extension": ".md"},
    "mcp": {"extension": ".json", "merge": "opencode.json"}
  },
  "sync": {
    "paths": {
      "project": {
        "agents": ".opencode/agents/{name}.md",
        "skills": ".opencode/skills/{name}/",
        "rules": ".opencode/rules/{name}.md",
        "workflows": ".opencode/commands/{name}.md",
        "mcp": "opencode.json"
      },
      "global": {
        "agents": ".config/opencode/agents/{name}.md",
        "skills": ".config/opencode/skills/{name}/",
        "rules": ".config/opencode/AGENTS.md",
        "workflows": ".config/opencode/commands/{name}.md",
        "mcp": ".config/opencode/opencode.json"
      }
    }
  },
  "skip": {
    "rules_project": "OpenCode's canonical project instructions file is AGENTS.md. This harness uses per-file rules until an AGENTS.md merger is added."
  }
}

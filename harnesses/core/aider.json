{
  "name": "aider",
  "label": "Aider",
  "builtin": true,
  "default_enabled": false,
  "auto_enable": true,
  "detect": {
    "commands": ["aider"],
    "paths": ["~/.aider.conf.yml"]
  },
  "renderers": {
    "agents": "markdown",
    "mcp": "json"
  },
  "schemas": {
    "agents": ["name", "description", "model", "architect", "editor-model", "weak-model", "reasoning-effort", "read"],
    "rules": ["name", "description"],
    "workflows": ["name", "description"],
    "mcp": ["name", "description"]
  },
  "field_mappings": {
    "agents": {
      "editor_model": "editor-model",
      "weak_model": "weak-model",
      "reasoning": "reasoning-effort"
    }
  },
  "models": {
    "agents": ["default", "openai/gpt-5.5", "anthropic/claude-sonnet-4.6", "gemini/gemini-3.1-pro"]
  },
  "outputs": {
    "agents": {"extension": ".md"},
    "rules": {"extension": ".md"},
    "workflows": {"extension": ".md"},
    "mcp": {"extension": ".json"}
  },
  "sync": {
    "paths": {
      "project": {
        "agents": ".aider/agents/{name}.md",
        "rules": ".aider/conventions/{name}.md",
        "workflows": ".aider/workflows/{name}.md"
      },
      "global": {
        "agents": ".aider/agents/{name}.md",
        "rules": ".aider/conventions/{name}.md",
        "workflows": ".aider/workflows/{name}.md"
      }
    },
    "skip": {
      "rules": "Aider loads conventions through .aider.conf.yml read entries or /read. Per-file conventions are managed here until a config merger can add read: entries.",
      "skills": "Aider does not document Agent Skills directories.",
      "mcp": "Aider does not document native MCP server configuration.",
      "hooks": "Aider does not document native hook files."
    }
  }
}

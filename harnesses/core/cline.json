{
  "name": "cline",
  "label": "Cline",
  "builtin": true,
  "default_enabled": false,
  "auto_enable": true,
  "detect": {
    "commands": ["cline"],
    "paths": ["~/.cline", "~/Documents/Cline"]
  },
  "renderers": {
    "agents": "markdown",
    "mcp": "json"
  },
  "schemas": {
    "agents": ["name", "description", "model", "roleDefinition", "whenToUse", "customInstructions"],
    "skills": ["name", "description"],
    "rules": ["name", "description", "paths"],
    "workflows": ["name", "description"],
    "mcp": ["name", "description", "command", "args", "env", "url", "headers", "disabled", "autoApprove"]
  },
  "field_mappings": {
    "agents": {
      "role_definition": "roleDefinition",
      "when_to_use": "whenToUse",
      "custom_instructions": "customInstructions"
    },
    "mcp": {
      "auto_approve": "autoApprove"
    }
  },
  "models": {
    "agents": ["default", "anthropic/claude-sonnet-4.6", "openai/gpt-5.5", "google/gemini-3.1-pro"]
  },
  "outputs": {
    "agents": {"extension": ".md"},
    "skills": {"directory": true},
    "rules": {"extension": ".md"},
    "workflows": {"extension": ".md"},
    "hooks": {"directory": false},
    "mcp": {"extension": ".json", "merge": "mcp.json"}
  },
  "sync": {
    "paths": {
      "project": {
        "agents": ".cline/agents/{name}.md",
        "skills": ".cline/skills/{name}/",
        "rules": ".clinerules/{name}.md",
        "workflows": ".cline/commands/{name}.md",
        "hooks": ".cline/hooks/{name}",
        "mcp": ".cline/mcp.json"
      },
      "global": {
        "agents": ".cline/agents/{name}.md",
        "skills": ".cline/skills/{name}/",
        "rules": "Documents/Cline/Rules/{name}.md",
        "workflows": ".cline/commands/{name}.md",
        "hooks": ".cline/hooks/{name}",
        "mcp": ".cline/mcp.json"
      }
    },
    "skip": {
      "mcp_ide": "Cline VS Code extension MCP settings may live inside extension storage; ~/.cline/mcp.json is for CLI-style managed configs."
    }
  }
}

{
  "name": "@wdm-uk/ai-management",
  "version": "1.1.0",
  "description": "Manage AI agents, skills, MCP servers, rules, workflows, hooks, harnesses, and templates from one local source of truth.",
  "repository": {
    "type": "git",
    "url": "https://github.com/WD-Mitchell/WDM-AI-Management"
  },
  "bin": {
    "wdm-ai": "bin/wdm-ai"
  },
  "files": [
    "ai_management",
    "bin/wdm-ai",
    "defaults.conf",
    "flags.md",
    "harnesses",
    "requirements.txt",
    "skills/core/AI-Management",
    "templates/core",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "scripts": {
    "ai": "wdm-ai",
    "web": "wdm-ai --no-open",
    "sync": "wdm-ai sync",
    "test": "python3 -m unittest discover -s tests",
    "postinstall": "python3 -m venv .venv && ./.venv/bin/python -m pip install -r requirements.txt && ./.venv/bin/python ./bin/wdm-ai bootstrap --quiet"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "license": "MIT"
}

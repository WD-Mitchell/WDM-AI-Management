{
  "name": "@wdm-uk/ai-management",
  "version": "0.1.0",
  "description": "Manage AI agents, skills, MCP servers, rules, workflows, hooks, harnesses, and templates from one local source of truth.",
  "bin": {
    "wdm-ai": "bin/wdm-ai"
  },
  "files": [
    "ai_management",
    "bin/wdm-ai",
    "defaults.conf",
    "flags.md",
    "harnesses",
    "skills/core/AI-Management",
    "templates/core",
    "README.md",
    "CONTRIBUTING.md",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "scripts": {
    "ai": "wdm-ai",
    "web": "wdm-ai --no-open",
    "sync": "wdm-ai sync",
    "postinstall": "./bin/wdm-ai bootstrap --quiet"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "license": "MIT"
}
